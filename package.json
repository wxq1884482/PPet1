{
  "name": "PPet3",
  "version": "3.3.1",
  "description": "给你的桌面添加一点趣味~",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.cjs",
  "repository": "https://github.com/zenghongtu/PPet.git",
  "homepage": "https://github.com/zenghongtu/PPet",
  "author": "zenghongtu <zenghongtu@gmail.com>",
  "scripts": {
    "start": "node scripts/watch.mjs",
    "build": "node scripts/build.mjs",
    "dist": "yarn build && electron-builder",
    "dist:dir": "yarn dist --dir -c.compression=store -c.mac.identity=null",
    "dist:all": "yarn run dist -wml",
    "dist:win": "yarn run dist --win --ia32",
    "dist:mac": "yarn run dist -m",
    "dist:linux": "yarn run dist -l",
    "release": "yarn dist -wml -p always",
    "patch": "yarn version --patch",
    "minor": "yarn version --minor",
    "major": "yarn version --major"
  },
  "engines": {
    "node": ">=22.17.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^4.0.0",
    "@electron/remote": "^2.1.2",
    "@rematch/core": "^2.2.0",
    "@rematch/persist": "^2.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/redux-state-sync": "^3.1.10",
    "@types/styled-components": "^5.1.34",
    "@vitejs/plugin-react": "^4.6.0",
    "antd": "^5.26.4",
    "chalk": "^5.4.1",
    "electron": "37.2.0",
    "electron-builder": "^26.0.12",
    "electron-store": "^10.1.0",
    "electron-window-state": "^5.0.3",
    "font-awesome": "^4.7.0",
    "globby": "^14.1.0",
    "less": "^4.3.0",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.6",
    "react-ga": "^3.3.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.6.3",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "redux-state-sync": "^3.1.4",
    "styled-components": "^6.1.19",
    "typescript": "^5.8.3",
    "vite": "^7.0.2",
    "vite-plugin-imp": "^2.4.0"
  },
  "env": {
    "//": "Used in build scripts",
    "HOST": "127.0.0.1",
    "PORT": 3344
  }
}
